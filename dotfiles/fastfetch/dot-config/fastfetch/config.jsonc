{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "sixel",
    "source": "~/.config/fastfetch/yaku.png",
    "width": 22,
    "padding": {
      "left": 3,
      "top": 1
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "type": "custom",
      "key": "\u001b[33m╭─────────────────────────────────\u001b[0m",
      "format": ""
    },
    {
      "type": "os",
      "key": "\u001b[33m│ \u001b[36m  \u001b[37mOS   \u001b[33m│\u001b[0m"
    },
    {
      "type": "kernel",
      "key": "\u001b[33m│ \u001b[36m󰻀  \u001b[37mKRNL \u001b[33m│\u001b[0m",
      "format": "{1} {2}"
    },
    {
      "type": "cpu",
      "key": "\u001b[33m│ \u001b[36m  \u001b[37mCPU  \u001b[33m│\u001b[0m",
      "format": "{1}"
    },
    {
      "type": "memory",
      "key": "\u001b[33m│ \u001b[36m  \u001b[37mRAM  \u001b[33m│\u001b[0m",
      "format": "{1} / {2}"
    },
    {
      "type": "shell",
      "key": "\u001b[33m│ \u001b[36m  \u001b[37mSH   \u001b[33m│\u001b[0m"
    },
    {
      "type": "terminal",
      "key": "\u001b[33m│ \u001b[36m  \u001b[37mTERM \u001b[33m│\u001b[0m"
    },
    {
      "type": "wm",
      "key": "\u001b[33m│ \u001b[36m󰍹  \u001b[37mDESK \u001b[33m│\u001b[0m"
    },
    {
      "type": "packages",
      "key": "\u001b[33m│ \u001b[36m󰏖  \u001b[37mPKGS \u001b[33m│\u001b[0m",
      "format": "{guix-all} Guix · {nix-all} Nix"
    },
    {
      "type": "command",
      "key": "\u001b[33m│ \u001b[36m󰃭  \u001b[37mAGE  \u001b[33m│\u001b[0m",
      "text": "printf '%d days\n' \"$(( ($(date +%s) - $(stat -c %W /)) / 86400 ))\""
    },
    {
      "type": "custom",
      "key": "\u001b[33m╰─────────────────────────────────\u001b[0m",
      "format": ""
    }
  ]
}
