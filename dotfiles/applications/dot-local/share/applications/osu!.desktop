[Desktop Entry]
Version=1.5
Type=Application
Name=osu!
Comment=A free-to-win rhythm game. Rhythm is just a *click* away!
Icon=osu
Exec=env PIPEWIRE_LATENCY=128/44100 TTP_PROXY=http://localhost:2080 HTTPS_PROXY=http://localhost:2080 NO_PROXY=localhost,127.0.0.1,::1 osu! %u
Terminal=false
MimeType=application/x-osu-beatmap-archive;application/x-osu-skin-archive;application/x-osu-beatmap;application/x-osu-storyboard;application/x-osu-replay;x-scheme-handler/osu;
Categories=Game;
StartupWMClass=osu!
SingleMainWindow=true
StartupNotify=true
